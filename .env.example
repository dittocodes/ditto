# Database — local MySQL80 (encode @ in password as %40 in URL)
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/menteetracker
# Remote example:
# DATABASE_URL=mysql+pymysql://user:password@16.16.70.205:3306/psychometric

# Cloudinary (document uploads: proofs, marksheets, counseling files)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: legacy S3 URLs for files uploaded before Cloudinary migration
S3_BUCKET_NAME=jgi-menteetrackers
S3_REGION=ap-south-1

# Insight service (document analysis / enrich)
GEMINI_API_KEY=your_insight_api_key
