FROM public.ecr.aws/lambda/python:3.11

# Set working directory
WORKDIR /var/task

# Install system dependencies in parallel and clean up immediately
RUN yum install -y \
        libpng \
        libjpeg-turbo \
        freetype \
        freetype-devel \
        libpng-devel \
        zlib-devel \
        chromium \
        atk \
        at-spi2-atk \
        gtk3 \
        libXcomposite \
        libXcursor \
        libXdamage \
        libXext \
        libXi \
        libXrandr \
        libXScrnSaver \
        libXtst \
        cups-libs \
        libXss \
        libasound2 \
    && yum clean all \
    && rm -rf /var/cache/yum/* \
    && rm -rf /tmp/*

# Upgrade pip tools in one step
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Copy only requirements first (for better caching)
COPY requirements.txt .

# Install Python packages with optimizations
# Using --no-deps where possible and installing to a temp location first
RUN pip install --no-cache-dir --no-compile -r requirements.txt -t . 2>&1 | grep -v "already satisfied" || true

# Quick verification (skip if it fails, we'll catch it later)
RUN python -c "import fastapi, sqlalchemy, pymysql, bcrypt, pydantic" 2>/dev/null || echo "Warning: Some packages may be missing"

# Copy application code (last step for better caching)
COPY app/ ./app

# Lambda entrypoint
CMD ["app.main.handler"]

