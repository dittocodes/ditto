FROM public.ecr.aws/lambda/python:3.11

WORKDIR /var/task

# Combine all system package installations and cleanup in one layer
RUN yum install -y \
        libpng libjpeg-turbo freetype freetype-devel libpng-devel zlib-devel \
        chromium atk at-spi2-atk gtk3 libXcomposite libXcursor libXdamage \
        libXext libXi libXrandr libXScrnSaver libXtst cups-libs libXss libasound2 \
    && yum clean all \
    && rm -rf /var/cache/yum \
    && pip install --upgrade pip setuptools wheel --no-cache-dir

# Copy requirements and install packages in one layer for better caching
COPY requirements.txt .
RUN pip install -r requirements.txt -t . && \
    python -c "import fastapi, sqlalchemy, pymysql, bcrypt, pydantic; print('✓ Verified')" && \
    rm -rf /tmp/pip-cache ~/.cache/pip

# Copy app code last (changes most frequently)
COPY app/ ./app

CMD ["app.main.handler"]

